<%= @body %>

<%= @labels[@document.kind.to_sym] %> <%= @document.number %> — <%= @labels[@document.receipt? ? :amount_received : :total] %>: <%= Commerce::DocumentLabels.money(@document.total, @document.currency, @document.language) %>
<%= format(@labels[:view_document], document: @labels[@document.kind.to_sym].downcase) %>: <%= @public_url %>
<% if @pay_online %><%= @labels[:pay_online] %>: <%= @public_url %>#pay
<% end %>

<%= @labels[:regards] %>
<%= @company['trade_name'].presence || @company['legal_name'] %>
<%= [@company['phone'], @company['email'], @company['website']].compact_blank.join("\n") %>
