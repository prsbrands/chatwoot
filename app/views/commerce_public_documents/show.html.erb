<% l = @labels %>
<% money = ->(value) { Commerce::DocumentLabels.money(value, @document.currency, @document.language) } %>
<% date = ->(value) { Commerce::DocumentLabels.date(value, @document.language) } %>
<% company = @document.company || {} %>
<% customer = @document.customer || {} %>
<% logo = company['logo_blob_id'] && ActiveStorage::Blob.find_by(id: company['logo_blob_id']) %>
<% kind = l[@document.kind.to_sym] %>
<% online_methods = @document.payable? ? @document.online_payment_methods : [] %>
<% processing = @checkout&.pending? %>
<!DOCTYPE html>
<html lang="<%= @document.language %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= kind %> <%= @document.number %></title>
  <%= render 'commerce_public_documents/style' %>
</head>
<body>
<main>
  <header>
    <div><% if logo %><%= image_tag url_for(logo), alt: company['trade_name'].to_s %><% end %></div>
    <div class="company">
      <strong><%= company['trade_name'].presence || company['legal_name'] %></strong>
      <% if company['legal_name'].present? && company['legal_name'] != company['trade_name'] %><div><%= company['legal_name'] %></div><% end %>
      <% if company['tax_id'].present? %><div><%= company['tax_id_label'] %> <%= company['tax_id'] %></div><% end %>
      <% %w[address phone email website].each do |field| %><% if company[field].present? %><div class="pre"><%= company[field] %></div><% end %><% end %>
    </div>
  </header>

  <h1><%= kind %> <%= @document.number %></h1>
  <div class="muted">
    <%= l[:issue_date] %>: <%= date.(@document.issue_date) %>
    <% if @document.due_date %> · <%= l[@document.quote? ? :valid_until : :due_date] %>: <%= date.(@document.due_date) %><% end %>
  </div>
  <% if @document.accepted? && @document.quote? %><p><span class="badge ok"><%= l[:accepted] %></span></p><% end %>
  <% if @document.declined? %><p><span class="badge no"><%= l[:declined] %></span></p><% end %>
  <% if @document.paid? %><p><span class="badge ok"><%= l[:status_paid] %></span></p><% end %>
  <% if @document.void? %><p><span class="badge no"><%= l[:status_void] %></span></p><% end %>
  <% if @checkout&.paid? %><div class="notice ok"><%= l[:payment_received] %></div><% end %>
  <% if @checkout&.failed? || @checkout&.expired? %><div class="notice no"><%= l[:payment_failed] %></div><% end %>
  <% if processing %>
    <div id="waiting" class="notice ghost waiting" data-status-url="<%= commerce_public_document_checkout_path(@document.public_token, @checkout.id) %>">
      <span class="spinner" aria-hidden="true"></span>
      <div>
        <div><strong><%= @checkout.provider.yappy? ? l[:yappy_approve] : l[:payment_processing] %></strong></div>
        <div id="waiting-timeout" class="muted" hidden><%= l[:payment_wait_timeout] %> <a href="<%= commerce_public_document_path(@document.public_token) %>"><%= l[:back_to_document] %></a></div>
      </div>
    </div>
    <script>
      (function () {
        var box = document.getElementById('waiting');
        var started = Date.now();
        var LIMIT_MS = 10 * 60 * 1000;
        function tick() {
          fetch(box.dataset.statusUrl, { headers: { Accept: 'application/json' }, cache: 'no-store' })
            .then(function (response) { return response.json(); })
            .then(function (data) {
              if (data.status !== 'pending') return window.location.reload();
              if (Date.now() - started > LIMIT_MS) return document.getElementById('waiting-timeout').removeAttribute('hidden');
              setTimeout(tick, 4000);
            })
            .catch(function () { setTimeout(tick, 8000); });
        }
        setTimeout(tick, 4000);
      })();
    </script>
  <% end %>
  <% if @pay_error %><div class="notice no"><%= l[:pay_error] %></div><% end %>

  <% if customer['name'].present? %>
    <section>
      <h2><%= l[@document.receipt? ? :received_from : :bill_to] %></h2>
      <div><strong><%= customer['name'] %></strong></div>
      <% if customer['tax_id'].present? %><div><%= customer['tax_id_label'] %> <%= customer['tax_id'] %></div><% end %>
      <% %w[address email phone].each do |field| %><% if customer[field].present? %><div class="pre"><%= customer[field] %></div><% end %><% end %>
    </section>
  <% end %>

  <% if @document.receipt? %>
    <% data = @document.details %>
    <section>
      <p><%= format(l[:receipt_statement], amount: money.(@document.total), document: "#{l[:invoice]} #{data['invoice_number']}") %></p>
      <div class="summary">
        <div><span><%= l[:payment_date] %></span><span><%= date.(data['paid_on'] && Date.parse(data['paid_on'])) %></span></div>
        <div><span><%= l[:payment_method] %></span><span><%= data['method'].presence || '—' %></span></div>
        <div><strong><%= l[:amount_received] %></strong><strong><%= money.(@document.total) %></strong></div>
        <div><span><%= l[:invoice_total] %></span><span><%= money.(data['invoice_total']) %></span></div>
        <div><span><%= l[:paid_to_date] %></span><span><%= money.(data['paid_to_date']) %></span></div>
        <div><span><%= l[:balance] %></span><span><%= money.(data['balance']) %></span></div>
      </div>
    </section>
  <% else %>
  <table>
    <thead><tr><th><%= l[:description] %></th><th class="num"><%= l[:quantity] %></th><th class="num"><%= l[:unit_price] %></th><th class="num"><%= l[:amount] %></th></tr></thead>
    <tbody>
    <% @document.items.each do |line| %>
      <tr>
        <td><strong><%= line.name %></strong><% if line.description.present? %><div class="muted pre"><%= line.description %></div><% end %>
          <% extras = [] %>
          <% extras << "#{l[:discount]} #{line.discount_percent.to_d.round(2).to_s('F').delete_suffix('.0')}%" if line.discount_percent.to_d.positive? %>
          <% extras << "#{l[:tax]} #{line.tax_rate.to_d.round(2).to_s('F').delete_suffix('.0')}%" if line.tax_rate.to_d.positive? && !@document.exempt? %>
          <% if extras.any? %><div class="muted"><%= extras.join(' · ') %></div><% end %>
        </td>
        <td class="num"><%= line.quantity.to_d.round(3).to_s('F').delete_suffix('.0') %> <%= Commerce::DocumentLabels.unit(@document.language, line.unit) %></td>
        <td class="num"><%= line.unit_price ? money.(line.unit_price) : l[:on_quote] %></td>
        <td class="num"><%= line.unit_price ? money.(line.line_total) : l[:on_quote] %></td>
      </tr>
    <% end %>
    </tbody>
  </table>

  <div class="totals">
    <div><span><%= l[:subtotal] %></span><span><%= money.(@document.subtotal) %></span></div>
    <% if @document.discount_total.positive? %><div><span><%= l[:discount_total] %></span><span>- <%= money.(@document.discount_total) %></span></div><% end %>
    <% if @document.exclusive? && @document.tax_total.positive? %><div><span><%= l[:tax_total] %></span><span><%= money.(@document.tax_total) %></span></div><% end %>
    <div class="grand"><span><%= l[:total] %></span><span><%= money.(@document.total) %></span></div>
    <% if @document.invoice? && @document.amount_paid.positive? %>
      <div><span><%= l[:paid] %></span><span><%= money.(@document.amount_paid) %></span></div>
      <div><strong><%= l[:balance] %></strong><strong><%= money.(@document.balance) %></strong></div>
    <% end %>
    <% if @document.exempt? %><div class="muted"><%= l[:tax_exempt] %></div><% elsif @document.inclusive? && @document.tax_total.positive? %><div class="muted"><%= l[:tax_included] %>: <%= money.(@document.tax_total) %></div><% end %>
  </div>
  <% end %>

  <% if online_methods.any? && !processing %>
    <% minimum = [Commerce::CheckoutStarter::MINIMUM, @document.balance].min %>
    <section id="pay" class="pay">
      <h2><%= l[:pay_online] %></h2>
      <%= form_tag commerce_public_document_pay_path(@document.public_token), method: :post do %>
        <label for="amount"><%= l[:amount_to_pay] %> (<%= @document.currency %>)</label>
        <input id="amount" name="amount" type="number" step="0.01" min="<%= minimum %>" max="<%= @document.balance %>" value="<%= @document.balance %>" required>
        <div class="muted"><%= format(l[:pay_amount_hint], minimum: money.(minimum)) %></div>
        <% if online_methods.any? { |method| method.provider.yappy? } %>
          <label for="phone" class="spaced"><%= l[:yappy_phone] %></label>
          <input id="phone" name="phone" type="tel" inputmode="numeric" pattern="[0-9]{8}" maxlength="8" placeholder="6000 0000">
        <% end %>
        <div class="actions">
          <% online_methods.each do |method| %>
            <button type="submit" name="payment_method_id" value="<%= method.id %>" class="btn primary"><%= format(l[:pay_with], method: method.name) %></button>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <% methods = @document.payment_methods.where(provider_id: nil) %>
  <% if methods.any? && !@document.receipt? && !@document.paid? && !@document.void? %>
    <section>
      <h2><%= l[:payment_methods] %></h2>
      <% methods.each do |method| %><div><strong><%= method.name %></strong></div><% if method.instructions.present? %><div class="pre muted"><%= method.instructions %></div><% end %><% end %>
    </section>
  <% end %>
  <% if @document.notes.present? %><section><h2><%= l[:notes] %></h2><div class="pre"><%= @document.notes %></div></section><% end %>
  <% if @document.terms.present? %><section><h2><%= l[:terms] %></h2><div class="pre"><%= @document.terms %></div></section><% end %>

  <div class="actions">
    <% if @document.quote? && @document.sent? && @document.display_status != 'expired' %>
      <%= button_to l[:accept], commerce_public_document_accept_path(@document.public_token), class: 'btn primary' %>
      <%= button_to l[:decline], commerce_public_document_decline_path(@document.public_token), class: 'btn ghost' %>
    <% end %>
    <%= link_to l[:download], commerce_public_document_pdf_path(@document.public_token), class: 'btn ghost', target: '_blank', rel: 'noopener' %>
  </div>
  <% if @document.footer.present? %><footer class="pre"><%= @document.footer %></footer><% end %>
</main>
</body>
</html>
